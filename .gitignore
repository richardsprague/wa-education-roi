# Data: raw pulls and derived artifacts are reproducible from scripts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
figures/*
!figures/.gitkeep

# Quarto / R
/.quarto/
_site/
# Quarto's freeze cache: regenerable render output, same rule as figures/
# and data/processed/. Drop this line if you'd rather ship it so the site
# can be rebuilt without re-running the ~30 min data pull.
_freeze/
*_files/
*_cache/
.Rproj.user/
.Rhistory
.RData
.Renviron
renv/library/
renv/staging/

# OS
.DS_Store

**/*.quarto_ipynb
